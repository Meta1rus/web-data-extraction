    {
      "parameters": {
        "executeOnce": true,
        "command": "=cd \"{{ $json.project_dir }}\" && {{ $json.env_prefix }} {{ $json.python }} src/run_pipeline.py --quiet {{ $json.args }}; echo \"PIPELINE_EXIT_CODE=$?\""
      },
      "id": "85533a11-ee90-5938-bab9-32df63ec057a",
      "name": "Запуск пайплайна",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        40,
        100
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "notes": "Повторы узла — только на случай сбоя запуска оболочки. Сетевые повторы, лимиты и предохранитель реализованы внутри пайплайна: повторный полный прогон по ошибке лишь удвоил бы нагрузку на GitHub.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Разбор вывода пайплайна: последняя строка RUN_SUMMARY {...} и код возврата PIPELINE_EXIT_CODE=N\nconst out = [];\nfor (const item of $input.all()) {\n  const stdout = String(item.json.stdout || '');\n  const lines = stdout.split('\\n');\n  const sumLine = [...lines].reverse().find(l => l.startsWith('RUN_SUMMARY '));\n  const codeLine = lines.find(l => l.startsWith('PIPELINE_EXIT_CODE='));\n  const exitCode = codeLine ? parseInt(codeLine.split('=')[1], 10) : -1;\n  let summary = {};\n  try {\n    summary = sumLine ? JSON.parse(sumLine.slice('RUN_SUMMARY '.length)) : {};\n  } catch (e) {\n    summary = { parse_error: String(e) };\n  }\n  // нет строки RUN_SUMMARY = пайплайн не дошёл до конца: считаем прогон красным\n  const verdict = summary.verdict || 'red';\n  out.push({ json: {\n    ...summary,\n    verdict,\n    exit_code: exitCode,\n    alerts: summary.alerts || (sumLine ? [] : ['нет строки RUN_SUMMARY: см. stderr']),\n    stderr_tail: String(item.json.stderr || '').slice(-1500),\n    checked_at: new Date().toISOString(),\n  }});\n}\nreturn out;"
      },
