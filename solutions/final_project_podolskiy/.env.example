# Скопируйте в .env и заполните. Файл .env в git не попадает (.gitignore).
# Токен GitHub (fine-grained, только чтение публичных репозиториев; права не нужны):
# https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=
# Переопределение адресов источников (для локальной имитации/демонстрации отказа). Обычно оставить пустыми.
GITHUB_HTML_BASE=
GITHUB_API_BASE=
