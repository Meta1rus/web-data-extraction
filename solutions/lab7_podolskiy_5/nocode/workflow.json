              "value": "https://www.scrapingcourse.com/ecommerce/",
              "type": "string"
            },
            {
              "id": "54bcca6b-96da-570f-bc6c-12c96740d853",
              "name": "pages",
              "value": 2,
              "type": "number"
            },
            {
              "id": "d6beea4d-e8a0-57dd-923c-721499dff698",
              "name": "min_cards",
              "value": 30,
              "type": "number"
            },
            {
              "id": "a5f53ca3-cef2-5c80-9190-caba8bfa2ebd",
              "name": "user_agent",
              "value": "PSU-edu-crawler/1.0 (+https://github.com/Meta1rus/web-data-extraction; student lab)",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "51365514-992e-5856-94a7-d6a661b34d35",
      "name": "Параметры",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        100
      ],
      "notes": "min_cards — порог проверки результата: меньше карточек в каталоге → подозрение на заглушку/поломку."
    },
    {
      "parameters": {
        "jsCode": "const p = $input.first().json;\nconst base = p.base_url.endsWith('/') ? p.base_url : p.base_url + '/';\nconst pages = Math.max(1, Math.min(Number(p.pages) || 1, 50));\nreturn Array.from({ length: pages }, (_, i) => ({ json: {\n  page_no: i + 1, page_url: i === 0 ? base : `${base}page/${i + 1}/`, user_agent: p.user_agent } }));"
      },
      "id": "70af9deb-a6b4-5ce8-941d-99d85e26f815",
      "name": "Номера страниц",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        100
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.page_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "={{ $json.user_agent }}"
            },
            {
              "name": "Accept-Encoding",
              "value": "gzip"
            }
          ]
        },
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 2000
            }
          },
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "html"
            }
          },
          "timeout": 20000
        }
      },
      "id": "9a63673e-2a1b-54c2-8253-7e55b59cef95",
      "name": "Страница каталога",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        100
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 5000,
      "notes": "Контроль скорости: 1 запрос в 2 с. Повторы: 4 попытки через 5 с (максимум интерфейса n8n)."
    },
    {
      "parameters": {
        "jsCode": "// Аналог детектора блокировок: маркеры заглушек и размер ответа (до разбора)\nconst MARKERS = ['captcha', 'are you human', 'access denied', 'unusual traffic', 'доступ ограничен'];\nreturn $input.all().map(({ json: j }) => {\n  const html = String(j.html || '');\n  const low = html.toLowerCase();\n  return { json: { html, size: html.length, markers: MARKERS.filter(m => low.includes(m)) } };\n});"
      },
      "id": "65577a16-f1fa-5d1d-a06c-a1c9e976d6e0",
      "name": "Проверка содержимого",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "operation": "extractHtmlContent",
        "dataPropertyName": "html",
        "extractionValues": {
          "values": [
            {
              "key": "links",
              "cssSelector": "ul.products li.product a.woocommerce-LoopProduct-link",
              "returnValue": "attribute",
              "attribute": "href",
              "returnArray": true
            },
            {
              "key": "prices",
              "cssSelector": "ul.products li.product a.woocommerce-LoopProduct-link .price",
              "returnValue": "text",
              "returnArray": true
            }
          ]
        },
        "options": {
          "trimValues": true
        }
      },
      "id": "9cedb96a-0d0e-57ae-9c3b-8338cdb6ed9b",
      "name": "Ссылки и цены в каталоге",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Отпечаток карточки «URL|цена в каталоге» — для инкрементальности; итог проверки — для IF\nconst pages = $('Проверка содержимого').all();\nconst suspicious = pages.filter(p => p.json.markers.length > 0 || p.json.size < 1500).length;\nconst out = [];\nfor (const { json: j } of $input.all()) {\n  (j.links || []).forEach((url, i) => out.push({ url, fp: `${url}|${(j.prices || [])[i] || ''}` }));\n}\nconst total = out.length;\nreturn (total ? out : [{ url: '', fp: '' }]).map(o => ({ json: { ...o, cards_total: total, suspicious_pages: suspicious } }));"
      },
      "id": "085a879b-8c07-56ad-a034-3dd22a276918",
      "name": "Отпечатки и итог проверки",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "b645d082-215c-590c-b8ac-7e6e99f5ac36",
              "leftValue": "={{ $json.cards_total }}",
              "rightValue": "={{ $('Параметры').first().json.min_cards }}",
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            },
            {
              "id": "327b7a4c-1dc4-5ee5-8b0e-0edd1c727761",
              "leftValue": "={{ $json.suspicious_pages }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "6cc5a7d0-1e07-525a-bea0-2a87404c317c",
      "name": "Карточек достаточно и нет заглушки?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1540,
        0
      ]
    },
    {
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "=Проверка результата не пройдена: карточек {{ $json.cards_total }} (порог {{ $('Параметры').first().json.min_cards }}), страниц-заглушек {{ $json.suspicious_pages }}. Сбор остановлен, скорость не повышаем."
      },
      "id": "52f3fc2c-3e96-51eb-b3d7-c37ab1f6016c",
      "name": "Подозрительно мало данных",
