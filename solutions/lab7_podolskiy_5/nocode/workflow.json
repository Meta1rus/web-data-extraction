      "id": "58c2f65e-9c50-58d0-8e91-aacdda807b65",
      "name": "Пауза 2 с между батчами",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        2640,
        0
      ],
      "notes": "Контроль скорости между батчами (аналог задержки ограничителя)."
    },
    {
      "parameters": {
        "jsCode": "const money = s => { const m = String(s || '').replace(/,/g, '').match(/\\d+(?:\\.\\d+)?/); return m ? Number(m[0]) : null; };\nconst clean = s => String(s || '').replace(/\\s+/g, ' ').trim();\nconst out = [];\nlet errors = 0;\nfor (const { json: j } of $input.all()) {\n  if (j.error_message) { errors++; continue; }\n  const sku = clean(j.sku).toUpperCase();\n  const cur = (j.price_ins && j.price_ins.length) ? j.price_ins : (j.price_all || []);\n  const amounts = cur.map(money).filter(v => v !== null && v > 0);\n  if (!sku || sku === 'N/A' || !amounts.length) continue;\n  out.push({ json: { sku, name: clean(j.name), price: Math.min(...amounts).toFixed(2),\n    categories: (j.categories || []).map(clean).join('; '), product_url: j.url || '',\n    scraped_at: new Date().toISOString(), card_errors_in_run: errors } });\n}\nreturn out;"
      },
      "id": "6c52ae54-75c9-5215-9507-8c3232c8fd21",
      "name": "Типизация",
