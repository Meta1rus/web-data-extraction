    {
      "parameters": {
        "jsCode": "return $input.all().map(({ json: e }) => {\n  const msg = `⚠️ ${e.workflow?.name}: выполнение ${e.execution?.id} упало на узле «${e.execution?.lastNodeExecuted}»: ${e.execution?.error?.message}`;\n  return { json: { text: msg, line: `${new Date().toISOString()}\\t${msg}\\n` } };\n});"
      },
      "id": "75aa859b-662d-510b-8c25-159ee8bdd64e",
