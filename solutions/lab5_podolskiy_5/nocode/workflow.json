      "id": "e16c45ab-f7e2-5d6c-b89c-a75b803f771d",
      "name": "Убрать дубли SKU",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "position": [
        1760,
        -220
      ],
      "notes": "Дедупликация по бизнес-ключу (артикул), как DedupPipeline."
    },
    {
      "parameters": {
        "jsCode": "// Аналог звеньев 100 (валидация) и 200 (очистка/типизация) Scrapy-пайплайна\nconst money = (s) => {\n  const m = String(s || '').replace(/,/g, '').match(/\\d+(?:\\.\\d+)?/);\n  return m ? Number(m[0]) : null;\n};\nconst clean = (s) => String(s || '').replace(/\\s+/g, ' ').trim();\nconst dropped = { error: 0, no_sku: 0, no_name: 0, bad_price: 0 };\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  if (j.error_message) { dropped.error++; continue; }\n  const sku = clean(j.sku).toUpperCase();\n  if (!sku || sku === 'N/A') { dropped.no_sku++; continue; }\n  const name = clean(j.name);\n  if (!name) { dropped.no_name++; continue; }\n  const current = (j.price_ins && j.price_ins.length) ? j.price_ins : (j.price_all || []);\n  const amounts = current.map(money).filter(v => v !== null && v > 0);\n  if (!amounts.length) { dropped.bad_price++; continue; }\n  const regular = (j.price_del || []).map(money).filter(v => v !== null);\n  const sym = current.join(' ');\n  out.push({ json: {\n    sku,\n    name,\n    price: Math.min(...amounts).toFixed(2),            // деньги строкой с 2 знаками — без ошибок float\n    price_max: amounts.length > 1 ? Math.max(...amounts).toFixed(2) : '',\n    regular_price: regular.length ? regular[0].toFixed(2) : '',\n    currency: sym.includes('£') ? 'GBP' : (sym.includes('€') ? 'EUR' : 'USD'),\n    categories: (j.categories || []).map(clean).filter(Boolean).join('; '),\n    description: clean(j.description).replace(/^description\\s*/i, ''),\n    image_url: /placeholder/i.test(j.image_url || '') ? '' : (j.image_url || ''),\n    product_url: j.url || '',\n    scraped_at: new Date().toISOString(),\n  } });\n}\nconsole.log('Отброшено записей:', JSON.stringify(dropped), '| прошло:', out.length);\nreturn out;"
      },
      "id": "bbd110f0-c059-518d-a9ea-a4956a4cb7f1",
      "name": "Проверка и типизация",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
