    {
      "parameters": {
        "jsCode": "// Пагинация циклом по номерам страниц: /ecommerce/, /ecommerce/page/2/, ...\nconst p = $input.first().json;\nconst base = p.base_url.endsWith('/') ? p.base_url : p.base_url + '/';\nconst pages = Math.max(1, Math.min(Number(p.pages) || 1, 50));   // предохранитель: не более 50 страниц\nconst out = [];\nfor (let n = 1; n <= pages; n++) {\n  out.push({ json: { page_no: n, page_url: n === 1 ? base : `${base}page/${n}/`, user_agent: p.user_agent } });\n}\nreturn out;"
      },
