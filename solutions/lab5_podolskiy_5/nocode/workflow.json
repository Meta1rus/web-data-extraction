    {
      "parameters": {
        "jsCode": "// Ветка ошибки: строка журнала + текст для мессенджера\nreturn $input.all().map(item => {\n  const j = item.json;\n  const line = `${new Date().toISOString()}\\t${j.stage}\\t${j.failed_url}\\t${j.error_message}\\n`;\n  return { json: { line, text: `⚠️ Лаб. 5: ошибка (${j.stage}) ${j.failed_url}: ${j.error_message}` } };\n});"
      },
