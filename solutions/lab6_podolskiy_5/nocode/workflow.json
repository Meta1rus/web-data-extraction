    {
      "parameters": {
        "jsCode": "// Добавляет 4 помеченные битые записи, чтобы показать ветку отбраковки и дедупликацию.\n// Для «чистого» прогона узел можно отключить (Deactivate) — поток не изменится.\nconst out = $input.all().map(i => i.json);\nif (out.length) {\n  const b = out[0];\n  out.push({ ...b, number: 900000001, title: ' \\u200b ', _synthetic: true });\n  out.push({ ...b, number: 900000002, state: 'closed', closed_at: null, _synthetic: true });\n  out.push({ ...b, number: 900000003, comments: -3, _synthetic: true });\n  out.push({ ...out[out.length - 1] });   // полный дубль — уберёт Remove Duplicates\n}\nreturn out.map(j => ({ json: j }));"
      },
      "id": "a105eb70-f70b-548e-bd09-f33093cd0c34",
      "name": "Демо: синтетические битые записи",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        60
      ],
      "notes": "Синтетика для демонстрации (5–10 % разрешено заданием); строки помечены is_synthetic = true."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f623fd2a-4b54-5efe-97a0-87a49b98f506",
              "name": "event_key",
              "value": "={{ 'scrapy/scrapy#' + $json.number }}",
              "type": "string"
            },
            {
              "id": "ba8df079-e0cb-5d41-a8ac-71c1092b745f",
              "name": "repo_key",
              "value": "scrapy/scrapy",
              "type": "string"
            },
            {
              "id": "17e0d10e-cbee-5864-87b2-dfe3a3e3dae4",
