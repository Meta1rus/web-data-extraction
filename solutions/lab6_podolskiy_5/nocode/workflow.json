              "value": "={{ $json.pull_request ? 'pull_request' : 'issue' }}",
              "type": "string"
            },
            {
              "id": "5335572a-72ee-558b-922b-b45a0f6e659b",
              "name": "title",
              "value": "={{ String($json.title || '').normalize('NFKC').replace(/[\\u200B-\\u200D\\u2060\\uFEFF]/g, '').replace(/\\s+/g, ' ').trim() }}",
              "type": "string"
            },
            {
              "id": "eba85dec-e51d-52a4-b310-ef5eca936555",
              "name": "state",
              "value": "={{ String($json.state || '').toLowerCase().trim() }}",
              "type": "string"
            },
            {
              "id": "cc8457c2-0e26-5482-a1dd-73a16a7e2342",
              "name": "created_at",
              "value": "={{ $json.created_at ? DateTime.fromISO($json.created_at, { setZone: true }).toUTC().toISO({ suppressMilliseconds: true }) : '' }}",
              "type": "string"
            },
            {
              "id": "3e3820ac-723f-5288-90d1-b30eb1e8b252",
              "name": "closed_at",
              "value": "={{ $json.closed_at ? DateTime.fromISO($json.closed_at, { setZone: true }).toUTC().toISO({ suppressMilliseconds: true }) : null }}",
              "type": "string"
            },
            {
              "id": "83243c8c-6241-50b6-bc41-6cf0905caea3",
              "name": "comments",
              "value": "={{ $json.comments }}",
              "type": "number"
            },
            {
              "id": "01e641de-f49d-560d-ace5-4e073b652294",
              "name": "label_color",
              "value": "={{ ($json.labels && $json.labels.length) ? String($json.labels[0].color).toLowerCase() : null }}",
              "type": "string"
            },
            {
              "id": "29185664-84c0-5d42-a8d1-716c13ed0231",
