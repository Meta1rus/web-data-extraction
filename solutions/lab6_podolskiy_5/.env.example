# Скопируйте в .env (cp .env.example .env). Файл .env не коммитится.
# Токен GitHub необязателен: без него лимит 60 запросов/час — хватает на один прогон (48 запросов).
# Подойдёт fine-grained token без прав (только чтение публичных данных).
GITHUB_TOKEN=
# Страниц /issues по 100 записей на репозиторий (12 × (1 + MAX_ISSUE_PAGES) запросов)
MAX_ISSUE_PAGES=3
# Пароль Postgres для no-code части (docker compose), по умолчанию lab6_local_only
LAB6_PG_PASSWORD=
