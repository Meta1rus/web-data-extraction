      "name": "HTML: поля цитаты",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        2200,
        -100
      ],
      "notes": "cleanUpText выключен намеренно: узел (v1.2) получает текст через html-to-text с переносом строк по 80 символов, а cleanUpText удаляет переносы без пробела и склеивает слова. Пробелы нормализует узел «Нормализация»."
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const base = $('Config').first().json.baseUrl;\nconst clean = s => String(s || '').normalize('NFKC').replace(/\\s+/g, ' ').trim();\nconst abs = h => !h ? '' : (/^https?:/i.test(h) ? h : base + (h.startsWith('/') ? '' : '/') + h);\nconst tags = String($json.keywords || '').split(',').map(t => t.trim()).filter(Boolean);\nreturn { json: {\n  text: clean($json.text).replace(/^[\\u201c\"]+|[\\u201d\"]+$/g, '').trim(),\n  author: clean($json.author),\n  author_url: abs($json.author_href),\n  goodreads_url: abs($json.goodreads_href),\n  tags_all: tags.join(','),\n  n_tags: tags.length,\n  auth_ok: Boolean($('Split Out: по цитате').item.json.loggedIn),\n  collected_at: new Date().toISOString(),\n}};\n"
      },
      "id": "98f24983-1b40-5629-8351-8274f4da432f",
      "name": "Нормализация",
