              "paginationMode": "responseContainsNextURL",
              "nextURL": "={{ $('Config').first().json.baseUrl + ($response.body.match(/<li class=\"next\">[\\s\\S]*?href=\"([^\"]+)\"/) || [])[1] }}",
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !/<li class=\"next\">/.test($response.body) }}",
              "limitPagesFetched": true,
              "maxRequests": 15,
              "requestInterval": 1000
            }
