    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Склеиваем cookie: из GET /login и (новую) из ответа POST /login\nconst jar = {};\nconst add = (sc) => [].concat(sc || []).forEach(c => {\n  const kv = String(c).split(';')[0];\n  const i = kv.indexOf('=');\n  if (i > 0) jar[kv.slice(0, i).trim()] = kv.slice(i + 1).trim();\n});\nadd($('GET /login').first().json.headers['set-cookie']);\nadd($input.first().json.headers['set-cookie']);\nconst cookie = Object.entries(jar).map(([k, v]) => `${k}=${v}`).join('; ');\nif (!cookie) throw new Error('Сервер не выдал cookie сессии');\nreturn [{ json: { cookie, loginStatus: $input.first().json.statusCode } }];\n"
      },
      "id": "43c049e1-7412-502c-a322-0e8c41d2ef56",
      "name": "Cookie сессии",
