    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Проверка полноты: ≥ 20 строк и ≤ 5 % пустых ключевых полей, вход активен\nconst items = $input.all();\nconst n = items.length;\nconst share = f => n ? items.filter(i => !i.json[f]).length / n : 1;\nconst bad = ['text', 'author', 'author_url', 'goodreads_url', 'auth_ok']\n  .map(f => [f, share(f)]).filter(([, v]) => v > 0.05);\nif (n < 20) throw new Error(`Smoke-check: строк ${n} < 20`);\nif (bad.length) throw new Error('Smoke-check: доля пустых > 5 %: ' +\n  bad.map(([f, v]) => `${f}=${(v * 100).toFixed(1)}%`).join(', '));\nreturn items;\n"
      },
      "id": "c1f63ab2-31cb-55a2-8051-39c6a706b51d",
      "name": "Smoke-check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
