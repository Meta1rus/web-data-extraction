# Скопируйте в .env (run_real.sh делает это сам, если .env нет).
# Учебные креды quotes.toscrape.com: сайт принимает ЛЮБОЙ логин/пароль, это не настоящий аккаунт.
QTS_USERNAME=student
QTS_PASSWORD=student

# Пауза вежливости между запросами, с (robots.txt на сайте нет, crawl-delay не задан)
POLITE_PAUSE=1.0
# 1 — без окна браузера; 0 — показать окно (для демонстрации)
HEADLESS=1

# --- только для офлайн-проверки на локальной имитации (tests/mock_site.py) ---
# BASE_URL=http://127.0.0.1:8765
# OUT_DIR=/tmp/lab4_mock
# PW_CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
