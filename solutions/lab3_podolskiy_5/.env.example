# Скопируйте этот файл в .env (cp .env.example .env) и при желании впишите ключ.
# Файл .env не коммитить: он в .gitignore.
# Без ключа блокнот работает в keyless-режиме (лимит ниже, паузы длиннее).
# Бесплатный Demo-ключ: https://www.coingecko.com/en/api/pricing → Create Demo Account → Developer Dashboard.
COINGECKO_DEMO_API_KEY=

# Необязательные настройки (значения по умолчанию указаны справа)
# CG_MIN_INTERVAL=6.5     # пауза между запросами, с (с ключом по умолчанию 2.5)
# CG_ENRICH_TOP=50        # сколько монет из топа обогащать через /market_chart
# CG_MAX_ATTEMPTS=6       # попыток на один запрос (1 основная + повторы)
